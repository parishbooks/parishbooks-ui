# Shared UI workspace env — copy to `.env.local` at this monorepo root.
# Used by OpenAPI codegen (`bun run openapi:generate`) and loaded into Next apps via next.config.js.
#
# Gateway (parishbooks-svc: docker compose up -d kong)
KONG_PROXY_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

BETTER_AUTH_URL=http://localhost:8001

# Service origins (host + port). OpenAPI: `{HOST}/api/docs-json`
AUTH_SERVICE_HOST=http://127.0.0.1:8001
BILLING_SERVICE_HOST=http://127.0.0.1:8002
MEMBER_SERVICE_HOST=http://127.0.0.1:8003
EVENTS_SERVICE_HOST=http://127.0.0.1:8004
GIVING_SERVICE_HOST=http://127.0.0.1:8005
LEDGER_SERVICE_HOST=http://127.0.0.1:8006
ORG_SERVICE_HOST=http://127.0.0.1:8007
