{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@parishbooks-ui/source"],
    "paths": {
      "@parishbooks-ui/design-system": ["libs/shared/design-system/src/index.ts"],
      "@parishbooks-ui/design-system/*": ["libs/shared/design-system/src/*"],
      "@parishbooks-ui/api-client": ["libs/shared/api-client/src/index.ts"],
      "@parishbooks-ui/api-client/generated/*": ["libs/shared/api-client/src/generated/*"],
      "@parishbooks-ui/site-ui": ["libs/shared/site-ui/src/index.ts"],
      "@parishbooks-ui/site-ui/*": ["libs/shared/site-ui/src/*"]
    }
  }
}
